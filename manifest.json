{
  "manifest_version": 3,
  "name": "Accessibility Evaluation Tool",
  "version": "1.0",
  "description": "An evaluation tool to check the accessibility of the current conversational AI interface.",
  "background": {
    "service_worker": "dist/background.bundle.js"

  },
  "options_page": "dist/options/options.html",
  
  "action": {
    "default_title": "Click to open panel"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "activeTab",
    "scripting",
    "audioCapture",
    "debugger",
    "tts",
    "ttsEngine"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "dist/qwPage.js",
        "dist/util.js",
        "dist/locales/en.js",
        "dist/act.js", 
        "dist/cui.js", 
        "dist/content.bundle.js", 
        "dist/wcag.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
      "dist/common-words-pt.txt",
      "dist/icons/icon_settings.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
