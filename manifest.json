{
  "manifest_version": 3,
  "name": "Accessibility Evaluation Tool",
  "version": "1.0",
  "description": "An evaluation tool to check the accessibility of the current conversational AI interface.",
  "background": {
    "service_worker": "dist/background.bundle.js"

  },
    "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",

    "128": "icons/icon-128.png"
  },
  "options_page": "dist/options/options.html",
  
  "action": {
    "default_title": "Click to open Qualweb CUI Checker",
     "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
    
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "activeTab",
    "scripting",
    "tts"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
},
"host_permissions": ["https://api.openai.com/*"],
  "web_accessible_resources": [
    {
      "resources": [
      "dist/common-words-pt.txt",
      "dist/icons/icon_settings.svg"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
