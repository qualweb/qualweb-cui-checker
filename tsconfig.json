{
  "compilerOptions": {
    "target": "es2016",  
    "lib": ["dom", "es2016"],
    "strict": true,
"module": "commonjs",

    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true
  },

  "outDir": "./dist",
  "types": ["chrome"],
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "test/**/*.ts",
  ]
}
