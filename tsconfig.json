{
  "compilerOptions": {
    "target": "es2016",
    "lib": ["dom", "es2016"],
    "strict": true,
    "module": "nodenext",
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "types": ["chrome", "vue"],
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts"
, ".vscode/background copy.ts"   ],
  "exclude": ["node_modules", "dist"]
}